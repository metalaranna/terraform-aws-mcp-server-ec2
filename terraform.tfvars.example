# Copy to terraform.tfvars and edit. terraform.tfvars is git-ignored.
region    = "us-east-1"
vpc_id    = "vpc-0123456789abcdef0"
subnet_id = "subnet-0123456789abcdef0"

# Your public IP in CIDR form, for example from https://checkip.amazonaws.com
allowed_cidr_blocks = ["203.0.113.10/32"]

# Optional overrides
# instance_type = "t3.small"
# mcp_image     = "hashicorp/terraform-mcp-server:1.3.0"
# mcp_port      = 8080
